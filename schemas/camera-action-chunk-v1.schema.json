{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "camera-action-chunk-v1.schema.json",
  "title": "CameraFrameActionChunkV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coordinate_frame",
    "representation",
    "units",
    "fps",
    "dimension_names",
    "values"
  ],
  "properties": {
    "schema_version": { "const": "CameraFrameActionChunkV1" },
    "coordinate_frame": { "const": "camera_optical" },
    "representation": { "const": "delta_ee_cam_r6d_gripper" },
    "units": { "type": "string" },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "dimension_names": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": { "type": "number" }
      }
    },
    "action_mask": {
      "type": ["array", "null"],
      "items": {
        "type": "array",
        "items": { "type": "number" }
      }
    },
    "normalization_method": { "type": "string" },
    "normalization_revision": { "type": "string" },
    "is_residual": { "type": "boolean" }
  }
}
