<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Standalone M1B scene.  The controller-backed Panda is spawned by the
       existing launch path; this file never alters the frozen M1A cube world. -->
  <world name="industrial_cylinder_v1">
    <physics name="bullet" type="bullet"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"><engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine></plugin>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"><render_engine>ogre2</render_engine></plugin>
    <gravity>0 0 -9.81</gravity>
    <light type="directional" name="industrial_light"><pose>0 0 5 0 0 0</pose><direction>-0.3 0.2 -0.9</direction><diffuse>0.9 0.9 0.9 1</diffuse></light>
    <model name="industrial_work_table"><static>true</static><link name="link"><pose>0 0 0.4 0 0 0</pose><collision name="collision"><geometry><box><size>1.5 1.0 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.5 1.0 0.1</size></box></geometry><material><diffuse>0.35 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name="camera_fixture"><static>true</static><link name="camera_rgbd"><pose>-0.80 -0.80 1.40 0 0.77 0.93</pose><sensor name="front_rgbd" type="rgbd_camera"><always_on>1</always_on><update_rate>15</update_rate><topic>/xh/camera/rgbd</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>4.0</far></clip></camera></sensor></link></model>
    <model name="incoming_zone_a"><static>true</static><link name="link"><pose>-0.28 -0.22 0.455 0 0 0</pose><visual name="visual"><geometry><box><size>0.36 0.24 0.01</size></box></geometry><material><diffuse>0.2 0.4 0.7 1</diffuse></material></visual></link></model>
    <model name="incoming_zone_b"><static>true</static><link name="link"><pose>-0.28 0.22 0.455 0 0 0</pose><visual name="visual"><geometry><box><size>0.36 0.24 0.01</size></box></geometry><material><diffuse>0.7 0.4 0.2 1</diffuse></material></visual></link></model>
