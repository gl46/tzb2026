  "$defs": {
    "AttachContactEntityParametersV1": {
      "additionalProperties": false,
      "properties": {
        "planner_resolution_required": {
          "const": true,
          "title": "Planner Resolution Required",
          "type": "boolean"
        },
        "target_ref": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Target Ref",
          "type": "string"
        },
        "contact_policy": {
          "const": "BOUND_BILATERAL_CONTACT",
          "title": "Contact Policy",
          "type": "string"
        }
      },
      "required": [
        "planner_resolution_required",
        "target_ref",
        "contact_policy"
      ],
      "title": "AttachContactEntityParametersV1",
      "type": "object"
    },
    "AttachContactEntitySkillStepV1": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "pattern": "^s[1-9][0-9]*$",
