    "CommanderAgentV1": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "CommanderAgentV1",
      "type": "string"
    },
    "CommanderPredicateNameV1": {
      "enum": [
        "IMAGE_CLEAR",
        "REGION_COUNT_RESOLVED",
        "TARGET_TRACK_BOUND",
        "DESTINATION_REGISTERED",
        "AGENT_AVAILABLE",
        "NO_SAFETY_BLOCKER",
        "GRASP_CONFIRMED",
        "PARTS_PACKED",
        "BIN_READY",
        "BIN_AT_DESTINATION",
        "TASK_COMPLETE",
        "FRESH_PUBLIC_OBSERVATION"
      ],
      "title": "CommanderPredicateNameV1",
      "type": "string"
    },
    "CommanderPredicateV1": {
      "additionalProperties": false,
      "properties": {
        "predicate": {
          "$ref": "#/$defs/CommanderPredicateNameV1"
        },
        "arguments": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "predicate"
      ],
      "title": "CommanderPredicateV1",
      "type": "object"
    },
    "CommanderSubtaskV1": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/CommanderAgentV1"
        },
        "skill_plan": {
          "items": {
            "discriminator": {
              "mapping": {
                "ATTACH_CONTACT_ENTITY": "#/$defs/AttachContactEntitySkillStepV1",
                "CARTESIAN_POSE": "#/$defs/CartesianPoseSkillStepV1",
                "GRIPPER_POSITION": "#/$defs/GripperPositionSkillStepV1",
                "PUBLIC_RGBD_CAPTURE": "#/$defs/PublicRgbdCaptureSkillStepV1",
                "PUBLIC_TRACK_REASSOCIATION": "#/$defs/PublicTrackReassociationSkillStepV1",
                "REMOVE_ATTACHMENT": "#/$defs/RemoveAttachmentSkillStepV1"
              },
              "propertyName": "primitive"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CartesianPoseSkillStepV1"
              },
              {
                "$ref": "#/$defs/GripperPositionSkillStepV1"
              },
              {
                "$ref": "#/$defs/AttachContactEntitySkillStepV1"
              },
              {
                "$ref": "#/$defs/RemoveAttachmentSkillStepV1"
              },
              {
                "$ref": "#/$defs/PublicRgbdCaptureSkillStepV1"
              },
              {
                "$ref": "#/$defs/PublicTrackReassociationSkillStepV1"
              }
            ]
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Skill Plan",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/CommanderPredicateV1"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "expected_postconditions": {
          "items": {
            "$ref": "#/$defs/CommanderPredicateV1"
          },
          "minItems": 1,
          "title": "Expected Postconditions",
          "type": "array"
        }
      },
      "required": [
        "agent",
        "skill_plan",
        "preconditions",
        "expected_postconditions"
      ],
      "title": "CommanderSubtaskV1",
      "type": "object"
    },
