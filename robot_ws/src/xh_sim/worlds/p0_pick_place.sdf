<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="xh_p0_pick_place">
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- Explicit systems are required for a server-only Harmonic run to expose
         physics, spawn services, contacts, the scene graph, and RGB-D output. -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <pose>0 0 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.8 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.8 0.1</size></box></geometry></visual>
      </link>
    </model>
    <!-- Camera fixture remains world-owned. The controller-backed Panda approximation is
         spawned by xh_sim's launch file, so its lifecycle can be checked independently. -->
    <model name="panda_p0_stub">
      <static>true</static>
      <pose>-0.35 0 0.45 0 0 0</pose>
      <link name="panda_link0">
        <visual name="base_visual"><geometry><cylinder><radius>0.12</radius><length>0.18</length></cylinder></geometry></visual>
      </link>
      <link name="panda_arm">
        <pose>0.18 0 0.32 0 1.57 0</pose>
        <visual name="arm_visual"><geometry><cylinder><radius>0.045</radius><length>0.68</length></cylinder></geometry></visual>
      </link>
      <link name="panda_hand">
        <pose>0.52 0 0.32 0 0 0</pose>
        <visual name="hand_visual"><geometry><box><size>0.12 0.08 0.08</size></box></geometry></visual>
      </link>
      <link name="parallel_gripper">
        <pose>0.62 0 0.32 0 0 0</pose>
        <visual name="left_finger"><pose>0 0.045 0 0 0 0</pose><geometry><box><size>0.10 0.012 0.035</size></box></geometry></visual>
        <visual name="right_finger"><pose>0 -0.045 0 0 0 0</pose><geometry><box><size>0.10 0.012 0.035</size></box></geometry></visual>
      </link>
      <link name="camera_rgbd">
        <pose>0.7 0 0.62 0 0.55 3.14</pose>
        <sensor name="front_rgbd" type="rgbd_camera">
          <always_on>1</always_on><update_rate>15</update_rate><topic>/xh/camera/rgbd</topic>
          <camera><horizontal_fov>1.047</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>4.0</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="object_red_cube">
      <pose>0.22 0.12 0.50 0 0 0</pose>
      <link name="link"><inertial><mass>0.08</mass></inertial><collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><diffuse>1 0 0 1</diffuse></material></visual><sensor name="red_cube_contact" type="contact"><always_on>1</always_on><update_rate>30</update_rate><topic>/xh/supervision/red_cube_contacts</topic><contact><collision>collision</collision></contact></sensor></link>
    </model>
    <model name="object_blue_cylinder">
      <pose>0.36 0.00 0.52 0 0 0</pose>
      <link name="link"><inertial><mass>0.06</mass></inertial><collision name="collision"><geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry><material><diffuse>0 0 1 1</diffuse></material></visual></link>
    </model>
    <model name="object_green_sphere">
      <pose>0.16 -0.12 0.49 0 0 0</pose>
      <link name="link"><inertial><mass>0.04</mass></inertial><collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><diffuse>0 1 0 1</diffuse></material></visual></link>
    </model>
    <model name="bin_a">
      <!-- An open 40 cm placement container: 2 cm floor plus four 8 cm walls.
           The interior is deliberately larger than the 5 cm task prop so the
           bounded controller demonstration has a meaningful placement margin. -->
      <!-- This center is the measured, collision-free release point of the
           bounded P0 transfer trajectory, not an inferred IK target. -->
      <static>true</static><pose>0.51 -0.06 0.45 0 0 0</pose>
      <link name="link">
        <collision name="floor_collision"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.40 0.40 0.02</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.40 0.40 0.02</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="left_wall_collision"><pose>0 0.19 0.05 0 0 0</pose><geometry><box><size>0.40 0.02 0.08</size></box></geometry></collision>
        <collision name="right_wall_collision"><pose>0 -0.19 0.05 0 0 0</pose><geometry><box><size>0.40 0.02 0.08</size></box></geometry></collision>
        <collision name="front_wall_collision"><pose>0.19 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.40 0.08</size></box></geometry></collision>
        <collision name="back_wall_collision"><pose>-0.19 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.40 0.08</size></box></geometry></collision>
        <visual name="left_wall_visual"><pose>0 0.19 0.05 0 0 0</pose><geometry><box><size>0.40 0.02 0.08</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <visual name="right_wall_visual"><pose>0 -0.19 0.05 0 0 0</pose><geometry><box><size>0.40 0.02 0.08</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <visual name="front_wall_visual"><pose>0.19 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.40 0.08</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <visual name="back_wall_visual"><pose>-0.19 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.40 0.08</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
