<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="xh_p0_pick_place">
    <physics name="default_physics" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- Explicit systems are required for a server-only Harmonic run to expose
         physics, spawn services, contacts, the scene graph, and RGB-D output. -->
    <!-- ADR-0009: the explicit generated SDF carries the q1<-q2 physical
         mimic constraint. The installed Bullet-Featherstone plugin is the
         required backend; the five-part capability audit must pass before S0. -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <pose>0 0 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.8 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.8 0.1</size></box></geometry></visual>
      </link>
    </model>
    <!-- The M0 visual-only Panda stub was removed for M1A. The only robot
         rendered in this world is the controller-backed model spawned by launch. -->
    <model name="camera_fixture">
      <static>true</static>
      <link name="camera_rgbd">
        <pose>0.7 0 0.62 0 0.55 3.14</pose>
        <sensor name="front_rgbd" type="rgbd_camera">
          <always_on>1</always_on><update_rate>15</update_rate><topic>/xh/camera/rgbd</topic>
          <camera><horizontal_fov>1.047</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>4.0</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="object_red_cube">
      <!-- Center is one half-side above the 0.45 m table top. This matches
           the MoveIt planning-scene object used by S0/S1. -->
      <pose>0.22 0.12 0.475 0 0 0</pose>
      <link name="link"><inertial><mass>0.08</mass></inertial><collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><diffuse>1 0 0 1</diffuse></material></visual><sensor name="red_cube_contact" type="contact"><always_on>1</always_on><update_rate>30</update_rate><topic>/xh/supervision/red_cube_contacts</topic><contact><collision>collision</collision></contact></sensor></link>
    </model>
    <model name="object_blue_cylinder">
      <pose>0.36 0.00 0.52 0 0 0</pose>
      <link name="link"><inertial><mass>0.06</mass></inertial><collision name="collision"><geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry><material><diffuse>0 0 1 1</diffuse></material></visual></link>
    </model>
    <model name="object_green_sphere">
      <!-- The approved bin relocation would otherwise start with this
           non-task prop inside bin_a; keep it as a separate tabletop prop. -->
      <pose>0.40 0.28 0.49 0 0 0</pose>
      <link name="link"><inertial><mass>0.04</mass></inertial><collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><diffuse>0 1 0 1</diffuse></material></visual></link>
    </model>
    <model name="bin_a">
      <!-- An open 30 cm placement container: 2 cm floor plus four 8 cm walls.
           The interior is deliberately larger than the 5 cm task prop so the
           bounded controller demonstration has a meaningful placement margin. -->
      <!-- M1A ADR-0006 placement center: exactly 0.62 m from the Panda base
           [-.35, 0] and 0.37 m from the red cube. This replaces the M0
           visual-stub release point, which was outside Panda place reach. -->
      <static>true</static><pose>0.217366447885 -0.249990627453 0.45 0 0 0</pose>
      <link name="link">
        <collision name="floor_collision"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.30 0.30 0.02</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.30 0.30 0.02</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="left_wall_collision"><pose>0 0.14 0.05 0 0 0</pose><geometry><box><size>0.30 0.02 0.08</size></box></geometry></collision>
        <collision name="right_wall_collision"><pose>0 -0.14 0.05 0 0 0</pose><geometry><box><size>0.30 0.02 0.08</size></box></geometry></collision>
        <collision name="front_wall_collision"><pose>0.14 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.30 0.08</size></box></geometry></collision>
        <collision name="back_wall_collision"><pose>-0.14 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.30 0.08</size></box></geometry></collision>
        <visual name="left_wall_visual"><pose>0 0.14 0.05 0 0 0</pose><geometry><box><size>0.30 0.02 0.08</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <visual name="right_wall_visual"><pose>0 -0.14 0.05 0 0 0</pose><geometry><box><size>0.30 0.02 0.08</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <visual name="front_wall_visual"><pose>0.14 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.30 0.08</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <visual name="back_wall_visual"><pose>-0.14 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.30 0.08</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
