<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="xh_p0_pick_place">
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <!-- Required for the calibration RGB-D camera to publish real frames in
         the server-only Harmonic process. -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- This world exists only to prove the S0 contact telemetry chain.  The
         production P0 task world and its cube pose are intentionally unchanged. -->
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <pose>0 0 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.8 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.8 0.1</size></box></geometry></visual>
      </link>
    </model>

    <!-- A narrow, explicitly modeled support keeps the calibration cube at a
         collision-free, IK-reachable height without any runtime pose write. -->
    <model name="work_table_calibration_fixture">
      <static>true</static>
      <link name="fixture_link">
        <pose>0.17 0.12 0.59 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.03 0.03 0.28</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.03 0.03 0.28</size></box></geometry><material><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="object_red_cube">
      <static>true</static>
      <pose>0.17 0.12 0.755 0 0 0</pose>
      <link name="link">
        <!-- S0 validates contact-message semantics, not grasp dynamics.  A
             static calibration target preserves all 13 independent windows. -->
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><diffuse>1 0 0 1</diffuse></material></visual>
        <sensor name="red_cube_contact" type="contact">
          <always_on>1</always_on><update_rate>30</update_rate>
          <topic>/xh/supervision/red_cube_contacts</topic>
          <contact><collision>collision</collision></contact>
        </sensor>
      </link>
    </model>

    <!-- Dynamic target-equivalent control: it is the same red 5 cm cube as
         the static finger target, but rests on the real work table so S0 can
         prove object-to-environment reporting without moving the grasp target. -->
    <model name="object_red_cube_environment">
      <pose>0.42 0.12 0.475 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.08</mass></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><diffuse>1 0 0 1</diffuse></material></visual>
        <sensor name="red_cube_environment_contact" type="contact">
          <always_on>1</always_on><update_rate>30</update_rate>
          <topic>/xh/supervision/red_cube_environment_contacts</topic>
          <contact><collision>collision</collision></contact>
        </sensor>
      </link>
    </model>

    <!-- Calibration recording uses the same explicit RGB-D transport as P0. -->
    <model name="calibration_camera_fixture">
      <static>true</static>
      <link name="camera_rgbd">
        <pose>0.7 0 0.85 0 0.75 3.14</pose>
        <sensor name="front_rgbd" type="rgbd_camera">
          <always_on>1</always_on><update_rate>15</update_rate><topic>/xh/camera/rgbd</topic>
          <camera><horizontal_fov>1.047</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>4.0</far></clip></camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
