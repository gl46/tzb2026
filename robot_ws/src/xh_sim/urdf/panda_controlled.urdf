<?xml version="1.0"?>
<!--
  P0 controller-validation robot. The seven actuated-joint origins and fixed
  wrist transform follow the hash-recorded node2 Panda resource; names, soft
  limits, units, interfaces and finger contact geometry remain project-local.
  Arm inertias/colliders are intentionally simple Panda-scale primitives, so
  this remains a control/contact model rather than a high-fidelity Franka model.
-->
<robot name="xh_panda_controlled">
  <material name="xh_white"><color rgba="0.82 0.84 0.86 1"/></material>
  <material name="xh_dark"><color rgba="0.18 0.20 0.24 1"/></material>

  <link name="world"/>
  <link name="panda_link0">
    <inertial><mass value="8.0"/><inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/></inertial>
    <visual><geometry><cylinder radius="0.12" length="0.16"/></geometry><material name="xh_dark"/></visual>
    <collision><geometry><cylinder radius="0.12" length="0.16"/></geometry></collision>
  </link>
  <!-- The model is spawned at the Gazebo world origin. This fixed transform is
       the single source for the measured controller/TF/world-frame placement. -->
  <joint name="world_to_panda" type="fixed"><origin xyz="-0.35 0 0.45" rpy="0 0 0"/><parent link="world"/><child link="panda_link0"/></joint>

  <!-- The legacy 33.3 cm cylinder reached the tabletop at a base height of
       .45 m.  These conservative bounds come from the official link1
       collision mesh: origin [.000087, -.037090, -.068515] m, size
       [.110148, .184565, .246977] m. -->
  <link name="panda_link1"><inertial><mass value="3.0"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.02"/></inertial><visual><origin xyz="0.000087 -0.037090 -0.068515"/><geometry><box size="0.110148 0.184565 0.246977"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0.000087 -0.037090 -0.068515"/><geometry><box size="0.110148 0.184565 0.246977"/></geometry></collision></link>
  <joint name="panda_joint1" type="revolute"><origin xyz="0 0 0.333" rpy="0 0 0"/><parent link="panda_link0"/><child link="panda_link1"/><axis xyz="0 0 1"/><limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.3925"/><dynamics damping="0.2"/></joint>

  <link name="panda_link2"><inertial><mass value="2.6"/><inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.018"/></inertial><visual><origin xyz="0 -0.158 0"/><geometry><box size="0.05 0.316 0.05"/></geometry><material name="xh_white"/></visual><collision><geometry><mesh filename="package://moveit_resources_panda_description/meshes/collision/link2.stl"/></geometry></collision></link>
  <joint name="panda_joint2" type="revolute"><origin xyz="0 0 0" rpy="-1.57079632679 0 0"/><parent link="panda_link1"/><child link="panda_link2"/><axis xyz="0 0 1"/><limit effort="87" lower="-1.7628" upper="1.7628" velocity="2.3925"/><dynamics damping="0.2"/></joint>

  <link name="panda_link3"><inertial><mass value="2.2"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.015"/></inertial><visual><origin xyz="0.04125 0 0"/><geometry><box size="0.0825 0.05 0.05"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0.04125 0 0"/><geometry><box size="0.0825 0.05 0.05"/></geometry></collision></link>
  <joint name="panda_joint3" type="revolute"><origin xyz="0 -0.316 0" rpy="1.57079632679 0 0"/><parent link="panda_link2"/><child link="panda_link3"/><axis xyz="0 0 1"/><limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.3925"/><dynamics damping="0.2"/></joint>

  <!-- Conservative primitive derived from the official Panda link4 collision
       mesh's axis-aligned bounds: origin [-.041234, .034430, .027923] m,
       size [.192746, .179159, .166259] m.  The prior 39.3 cm, arbitrarily
       rotated box intersected link6 in every probed configuration. -->
  <link name="panda_link4"><inertial><mass value="1.8"/><inertia ixx="0.016" ixy="0" ixz="0" iyy="0.016" iyz="0" izz="0.012"/></inertial><visual><origin xyz="-0.041234 0.034430 0.027923"/><geometry><box size="0.192746 0.179159 0.166259"/></geometry><material name="xh_white"/></visual><collision><geometry><mesh filename="package://moveit_resources_panda_description/meshes/collision/link4.stl"/></geometry></collision></link>
  <joint name="panda_joint4" type="revolute"><origin xyz="0.0825 0 0" rpy="1.57079632679 0 0"/><parent link="panda_link3"/><child link="panda_link4"/><axis xyz="0 0 1"/><limit effort="87" lower="-3.0718" upper="0.0175" velocity="2.3925"/><dynamics damping="0.16"/></joint>

  <link name="panda_link5"><inertial><mass value="1.3"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.009"/></inertial><visual><geometry><box size="0.06 0.06 0.08"/></geometry><material name="xh_white"/></visual><collision><geometry><box size="0.06 0.06 0.08"/></geometry></collision></link>
  <joint name="panda_joint5" type="revolute"><origin xyz="-0.0825 0.384 0" rpy="-1.57079632679 0 0"/><parent link="panda_link4"/><child link="panda_link5"/><axis xyz="0 0 1"/><limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.8710"/><dynamics damping="0.12"/></joint>

  <link name="panda_link6"><inertial><mass value="0.9"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.006"/></inertial><visual><origin xyz="0.044 0 0"/><geometry><box size="0.088 0.05 0.05"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0.044 0 0"/><geometry><box size="0.088 0.05 0.05"/></geometry></collision></link>
  <joint name="panda_joint6" type="revolute"><origin xyz="0 0 0" rpy="1.57079632679 0 0"/><parent link="panda_link5"/><child link="panda_link6"/><axis xyz="0 0 1"/><limit effort="12" lower="-0.0175" upper="3.7525" velocity="2.8710"/><dynamics damping="0.10"/></joint>

  <link name="panda_link7"><inertial><mass value="0.6"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.004"/></inertial><visual><origin xyz="0 0 0.04"/><geometry><box size="0.05 0.05 0.08"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0 0 0.04"/><geometry><box size="0.05 0.05 0.08"/></geometry></collision></link>
  <joint name="panda_joint7" type="revolute"><origin xyz="0.088 0 0" rpy="1.57079632679 0 0"/><parent link="panda_link6"/><child link="panda_link7"/><axis xyz="0 0 1"/><limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.8973"/><dynamics damping="0.08"/></joint>

  <!-- Official Panda's unactuated wrist offset. It is intentionally absent
       from all controllers and action vectors. -->
  <link name="panda_link8"><inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><geometry><box size="0.04 0.04 0.04"/></geometry><material name="xh_dark"/></visual><collision><geometry><box size="0.04 0.04 0.04"/></geometry></collision></link>
  <joint name="panda_joint8" type="fixed"><origin xyz="0 0 0.107" rpy="0 0 0"/><parent link="panda_link7"/><child link="panda_link8"/></joint>

  <!-- ADR-0016: compact inline palm.  The wrist, palm and pads now share
       local +Z as the tool/finger axis; closing remains local +/-Y. -->
  <link name="panda_hand"><inertial><mass value="0.5"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial><visual><origin xyz="0 0 0.03"/><geometry><box size="0.07 0.06 0.06"/></geometry><material name="xh_dark"/></visual><collision><origin xyz="0 0 0.03"/><geometry><box size="0.07 0.06 0.06"/></geometry></collision></link>
  <joint name="panda_hand_joint" type="fixed"><origin xyz="0 0 0" rpy="0 0 -0.785398163397"/><parent link="panda_link8"/><child link="panda_hand"/></joint>

  <link name="panda_rightfinger"><inertial><mass value="0.08"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial><visual><origin xyz="0 0 0.04"/><geometry><box size="0.022 0.010 0.08"/></geometry><material name="xh_dark"/></visual><visual name="tapered_tip_visual"><origin xyz="0 0 0.09"/><geometry><box size="0.012 0.006 0.02"/></geometry><material name="xh_dark"/></visual><collision name="collision"><origin xyz="0 0 0.04"/><geometry><box size="0.022 0.010 0.08"/></geometry></collision><collision name="tapered_tip_collision"><origin xyz="0 0 0.09"/><geometry><box size="0.012 0.006 0.02"/></geometry></collision></link>
  <!-- q2 is the physical master selected by ADR-0008's pre-authorized
       PANDA_MIMIC_Q2_MASTER fallback. It is deliberately declared before its
       q1 follower because the URDF→Gazebo importer resolves mimic leaders in
       declaration order. The spawned-SDF audit must still prove the physical
       q1 follower constraint before this model can promote S0. -->
  <joint name="panda_finger_joint2" type="prismatic"><origin xyz="0 0 0.06" rpy="0 0 0"/><parent link="panda_hand"/><child link="panda_rightfinger"/><axis xyz="0 -1 0"/><limit effort="20" lower="0" upper="0.04" velocity="0.2"/><dynamics damping="1.0"/></joint>

  <link name="panda_leftfinger"><inertial><mass value="0.08"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial><visual><origin xyz="0 0 0.04"/><geometry><box size="0.022 0.010 0.08"/></geometry><material name="xh_dark"/></visual><visual name="tapered_tip_visual"><origin xyz="0 0 0.09"/><geometry><box size="0.012 0.006 0.02"/></geometry><material name="xh_dark"/></visual><collision name="collision"><origin xyz="0 0 0.04"/><geometry><box size="0.022 0.010 0.08"/></geometry></collision><collision name="tapered_tip_collision"><origin xyz="0 0 0.09"/><geometry><box size="0.012 0.006 0.02"/></geometry></collision></link>
  <!-- ADR-0008 pre-authorized active-joint fallback: q1 is the follower after
       the bounded q1-master close probe left it physically at 4 cm. The
       positive-open joint protocol is unchanged. -->
  <joint name="panda_finger_joint1" type="prismatic"><origin xyz="0 0 0.06" rpy="0 0 0"/><parent link="panda_hand"/><child link="panda_leftfinger"/><axis xyz="0 1 0"/><limit effort="20" lower="0" upper="0.04" velocity="0.2"/><dynamics damping="1.0"/><mimic joint="panda_finger_joint2" multiplier="1" offset="0"/></joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <!-- Start Gazebo at the SRDF's collision-checked home, rather than at the
         all-zero configuration that self-collides under the enabled ACM. -->
    <joint name="panda_joint1"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="panda_joint2"><command_interface name="position"/><state_interface name="position"><param name="initial_value">-0.5</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="panda_joint3"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="panda_joint4"><command_interface name="position"/><state_interface name="position"><param name="initial_value">-1.5</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="panda_joint5"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="panda_joint6"><command_interface name="position"/><state_interface name="position"><param name="initial_value">1.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="panda_joint7"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <!-- Start open so the two collision shapes do not interpenetrate before
         their first controller command. Declare q2 before q1: gz_ros2_control
         initializes and logs a follower's master by index, so q1-first would
         print an empty leader although the mapping itself is indexed correctly. -->
    <joint name="panda_finger_joint2"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.02</param></state_interface><state_interface name="velocity"/></joint>
    <!-- q1 is observable only. hardware_interface parses the structural URDF
         mimic unless this ros2_control joint explicitly opts out, which would
         make gz_ros2_control write a second q1 velocity command. This leaves
         the generated SDF/Bullet constraint as the sole physical follower
         mechanism. The compatibility adapter remains the stable two-name
         action boundary and forwards only q2 to the physical controller. -->
    <joint name="panda_finger_joint1" mimic="false"><state_interface name="position"><param name="initial_value">0.02</param></state_interface><state_interface name="velocity"/></joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find xh_sim)/config/panda_controllers.yaml</parameters>
      <hold_joints>true</hold_joints>
      <!-- Jazzy gz_ros2_control documents 1.0 as the largest non-oscillatory
           position-interface gain. The previous default 0.1 left joints 5/6
           more than 0.16 rad short after trajectory completion. -->
      <position_proportional_gain>1.0</position_proportional_gain>
    </plugin>
    <!-- A deliberately explicit minimum-viable grasp constraint.  The plugin
         can retain its creation-time attachment, so every production episode
         must explicitly detach and observe `detached` before it may attach.
         This is not represented as a finger-contact grasp in supervision. -->
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>panda_link7</parent_link>
      <child_model>object_red_cube</child_model>
      <child_link>link</child_link>
      <detach_topic>/xh/p0/red_cube/detach</detach_topic>
      <attach_topic>/xh/p0/red_cube/attach</attach_topic>
      <output_topic>/xh/p0/red_cube/grasp_state</output_topic>
    </plugin>
  </gazebo>
  <!-- Separate finger sensors are required for M1A's bilateral-contact gate.
       They are supervision telemetry only and are never injected into ObservationV0. -->
  <gazebo reference="panda_leftfinger">
    <sensor name="left_finger_contact" type="contact">
      <always_on>1</always_on><update_rate>30</update_rate>
      <topic>/xh/supervision/panda_leftfinger_contacts</topic>
      <contact><collision>panda_leftfinger_fixed_joint_lump__collision_collision</collision></contact>
    </sensor>
  </gazebo>
  <gazebo reference="panda_rightfinger">
    <sensor name="right_finger_contact" type="contact">
      <always_on>1</always_on><update_rate>30</update_rate>
      <topic>/xh/supervision/panda_rightfinger_contacts</topic>
      <contact><collision>panda_rightfinger_fixed_joint_lump__collision_collision</collision></contact>
    </sensor>
  </gazebo>
</robot>
