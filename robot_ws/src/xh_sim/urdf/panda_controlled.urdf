<?xml version="1.0"?>
<!--
  P0 controller-validation robot.  The names, joint order, ranges, and parallel
  finger layout follow Panda conventions, while link inertias/colliders are
  intentionally simple primitives.  It is suitable for validating ROS control,
  TF, and safe joint trajectories; it is not a high-fidelity contact model.
-->
<robot name="xh_panda_controlled">
  <material name="xh_white"><color rgba="0.82 0.84 0.86 1"/></material>
  <material name="xh_dark"><color rgba="0.18 0.20 0.24 1"/></material>

  <link name="world"/>
  <link name="panda_link0">
    <inertial><mass value="8.0"/><inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/></inertial>
    <visual><geometry><cylinder radius="0.12" length="0.16"/></geometry><material name="xh_dark"/></visual>
    <collision><geometry><cylinder radius="0.12" length="0.16"/></geometry></collision>
  </link>
  <!-- The model is spawned at the Gazebo world origin. This fixed transform is
       the single source for the measured controller/TF/world-frame placement. -->
  <joint name="world_to_panda" type="fixed"><origin xyz="-0.35 0 0.45" rpy="0 0 0"/><parent link="world"/><child link="panda_link0"/></joint>

  <link name="panda_link1"><inertial><mass value="3.0"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.02"/></inertial><visual><origin xyz="0 0 0.16"/><geometry><cylinder radius="0.055" length="0.32"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0 0 0.16"/><geometry><cylinder radius="0.055" length="0.32"/></geometry></collision></link>
  <joint name="panda_joint1" type="revolute"><origin xyz="0 0 0.16" rpy="0 0 0"/><parent link="panda_link0"/><child link="panda_link1"/><axis xyz="0 0 1"/><limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.3925"/><dynamics damping="0.2"/></joint>

  <link name="panda_link2"><inertial><mass value="2.6"/><inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.018"/></inertial><visual><origin xyz="0 0 0.16"/><geometry><cylinder radius="0.05" length="0.32"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0 0 0.16"/><geometry><cylinder radius="0.05" length="0.32"/></geometry></collision></link>
  <joint name="panda_joint2" type="revolute"><origin xyz="0 0 0.32" rpy="-1.57079632679 0 0"/><parent link="panda_link1"/><child link="panda_link2"/><axis xyz="0 0 1"/><limit effort="87" lower="-1.7628" upper="1.7628" velocity="2.3925"/><dynamics damping="0.2"/></joint>

  <link name="panda_link3"><inertial><mass value="2.2"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.015"/></inertial><visual><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.045" length="0.30"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.045" length="0.30"/></geometry></collision></link>
  <joint name="panda_joint3" type="revolute"><origin xyz="0 0 0.32" rpy="1.57079632679 0 0"/><parent link="panda_link2"/><child link="panda_link3"/><axis xyz="0 0 1"/><limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.3925"/><dynamics damping="0.2"/></joint>

  <link name="panda_link4"><inertial><mass value="1.8"/><inertia ixx="0.016" ixy="0" ixz="0" iyy="0.016" iyz="0" izz="0.012"/></inertial><visual><origin xyz="0 0 0.13"/><geometry><cylinder radius="0.042" length="0.26"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0 0 0.13"/><geometry><cylinder radius="0.042" length="0.26"/></geometry></collision></link>
  <joint name="panda_joint4" type="revolute"><origin xyz="0 0 0.30" rpy="1.57079632679 0 0"/><parent link="panda_link3"/><child link="panda_link4"/><axis xyz="0 0 1"/><limit effort="87" lower="-3.0718" upper="0.0175" velocity="2.3925"/><dynamics damping="0.16"/></joint>

  <link name="panda_link5"><inertial><mass value="1.3"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.009"/></inertial><visual><origin xyz="0 0 0.12"/><geometry><cylinder radius="0.038" length="0.24"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0 0 0.12"/><geometry><cylinder radius="0.038" length="0.24"/></geometry></collision></link>
  <joint name="panda_joint5" type="revolute"><origin xyz="0 0 0.26" rpy="-1.57079632679 0 0"/><parent link="panda_link4"/><child link="panda_link5"/><axis xyz="0 0 1"/><limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.8710"/><dynamics damping="0.12"/></joint>

  <link name="panda_link6"><inertial><mass value="0.9"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.006"/></inertial><visual><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.034" length="0.20"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.034" length="0.20"/></geometry></collision></link>
  <joint name="panda_joint6" type="revolute"><origin xyz="0 0 0.24" rpy="1.57079632679 0 0"/><parent link="panda_link5"/><child link="panda_link6"/><axis xyz="0 0 1"/><limit effort="12" lower="-0.0175" upper="3.7525" velocity="2.8710"/><dynamics damping="0.10"/></joint>

  <link name="panda_link7"><inertial><mass value="0.6"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.004"/></inertial><visual><origin xyz="0 0 0.09"/><geometry><cylinder radius="0.03" length="0.18"/></geometry><material name="xh_white"/></visual><collision><origin xyz="0 0 0.09"/><geometry><cylinder radius="0.03" length="0.18"/></geometry></collision></link>
  <joint name="panda_joint7" type="revolute"><origin xyz="0 0 0.20" rpy="1.57079632679 0 0"/><parent link="panda_link6"/><child link="panda_link7"/><axis xyz="0 0 1"/><limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.8973"/><dynamics damping="0.08"/></joint>

  <link name="panda_hand"><inertial><mass value="0.5"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial><visual><origin xyz="0 0 0.055"/><geometry><box size="0.10 0.08 0.11"/></geometry><material name="xh_dark"/></visual><collision><origin xyz="0 0 0.055"/><geometry><box size="0.10 0.08 0.11"/></geometry></collision></link>
  <joint name="panda_hand_joint" type="fixed"><origin xyz="0 0 0.18" rpy="0 0 0"/><parent link="panda_link7"/><child link="panda_hand"/></joint>

  <link name="panda_leftfinger"><inertial><mass value="0.08"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial><visual><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.035"/></geometry><material name="xh_dark"/></visual><collision name="panda_leftfinger_collision"><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.035"/></geometry></collision></link>
  <joint name="panda_finger_joint1" type="prismatic"><origin xyz="0 0 0.055" rpy="0 0 0"/><parent link="panda_hand"/><child link="panda_leftfinger"/><axis xyz="0 1 0"/><limit effort="20" lower="0" upper="0.04" velocity="0.2"/><dynamics damping="1.0"/></joint>

  <link name="panda_rightfinger"><inertial><mass value="0.08"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial><visual><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.035"/></geometry><material name="xh_dark"/></visual><collision name="panda_rightfinger_collision"><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.035"/></geometry></collision></link>
  <joint name="panda_finger_joint2" type="prismatic"><origin xyz="0 0 0.055" rpy="0 0 0"/><parent link="panda_hand"/><child link="panda_rightfinger"/><axis xyz="0 -1 0"/><limit effort="20" lower="0" upper="0.04" velocity="0.2"/><dynamics damping="1.0"/></joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="panda_joint1"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="panda_joint2"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="panda_joint3"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="panda_joint4"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="panda_joint5"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="panda_joint6"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="panda_joint7"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <!-- Start open so the two collision shapes do not interpenetrate before
         their first controller command. -->
    <joint name="panda_finger_joint1"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.02</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="panda_finger_joint2"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.02</param></state_interface><state_interface name="velocity"/></joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find xh_sim)/config/panda_controllers.yaml</parameters>
      <hold_joints>true</hold_joints>
      <position_proportional_gain>0.1</position_proportional_gain>
    </plugin>
    <!-- A deliberately explicit minimum-viable grasp constraint.  It starts
         detached and can only be joined by the bounded P0 transfer runner.
         This is not represented as a finger-contact grasp in supervision. -->
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>panda_link7</parent_link>
      <child_model>object_red_cube</child_model>
      <child_link>link</child_link>
      <detach_topic>/xh/p0/red_cube/detach</detach_topic>
      <attach_topic>/xh/p0/red_cube/attach</attach_topic>
      <output_topic>/xh/p0/red_cube/grasp_state</output_topic>
    </plugin>
  </gazebo>
  <!-- Separate finger sensors are required for M1A's bilateral-contact gate.
       They are supervision telemetry only and are never injected into ObservationV0. -->
  <gazebo reference="panda_leftfinger">
    <sensor name="left_finger_contact" type="contact">
      <always_on>1</always_on><update_rate>30</update_rate>
      <topic>/xh/supervision/panda_leftfinger_contacts</topic>
      <contact><collision>panda_leftfinger_collision</collision></contact>
    </sensor>
  </gazebo>
  <gazebo reference="panda_rightfinger">
    <sensor name="right_finger_contact" type="contact">
      <always_on>1</always_on><update_rate>30</update_rate>
      <topic>/xh/supervision/panda_rightfinger_contacts</topic>
      <contact><collision>panda_rightfinger_collision</collision></contact>
    </sensor>
  </gazebo>
</robot>
